# 复制为 devops/.env.integration 或 export 后跑集成测试

# --- Arango（compose 默认）---
LFX_LIAM_ARANGO_URL=http://127.0.0.1:18529
LFX_LIAM_ARANGO_PASSWORD=liamtest
LFX_LIAM_ARANGO_USERNAME=root
LFX_LIAM_ARANGO_DATABASE=_system
LFX_LIAM_ARANGO_PORT=18529

# --- Astra 云（可选；不配则跳过 Astra 集成测试）---
# LFX_LIAM_ASTRA_API_ENDPOINT=https://xxxx-xxxx.apps.astra.datastax.com
# LFX_LIAM_ASTRA_TOKEN=AstraCS:...
# LFX_LIAM_ASTRA_KEYSPACE=default_keyspace

# --- 本地/自建 Data API = HCD（可选；与云 Astra 二选一）---
