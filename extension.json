{
  "$schema": "https://schemas.langflow.org/extension/v1.json",
  "id": "lfx-liam-bundle",
  "version": "0.0.1",
  "name": "Liam Bundle",
  "description": "Liam 的 Langflow 扩展工具包（liam）。当前提供 GraphRAG 等控件，可在同一 bundle 下继续扩展。",
  "lfx": {
    "compat": [
      "1"
    ]
  },
  "bundles": [
    {
      "name": "liam",
      "path": "src/lfx_liam_bundle/components/liam",
      "display_name": "Liam",
      "icon": "Package"
    }
  ]
}
